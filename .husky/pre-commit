set -eu
# shellcheck source=.husky/lib/change-scope.sh
. "$(dirname "$0")/lib/change-scope.sh"

pnpm exec lint-staged

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner
else
  echo "pre-commit: gitleaks is not installed; the local secret scan was skipped (CI runs it)."
fi

# No --diff-filter and --no-renames: deletions and both sides of a rename count.
if staged=$(git -c core.quotePath=false diff --cached --name-only --no-renames); then
  verdict=$(judge pre-commit "$staged")
else
  echo "pre-commit: could not compute the staged change; running the full checks." >&2
  staged=
  verdict=unjudged
fi
# An empty staged change (an amend or --allow-empty) affects no file to scope by,
# and `nx affected --files` takes a comma-separated list, so a path holding a
# comma cannot be passed to it: both run every project's checks.
[ -n "$staged" ] || verdict=unjudged
case $staged in *,*) verdict=unjudged ;; esac

if printf '%s\n' "$staged" | grep -q '^openspec/'; then
  pnpm exec openspec validate --all --strict --no-interactive
fi

case $verdict in
  docs-only) echo "pre-commit: documentation-only change; lint, typecheck and test not run." ;;
  full) pnpm nx affected -t lint typecheck test --files="$(printf '%s\n' "$staged" | paste -sd, -)" ;;
  *) pnpm nx run-many -t lint typecheck test ;;
esac
