{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "nx": {
    "name": "api",
    "tags": [
      "type:app",
      "scope:api"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "main": "apps/api/src/main.ts",
          "outputPath": "apps/api/dist",
          "tsConfig": "apps/api/tsconfig.app.json",
          "swcrc": "apps/api/.swcrc",
          "stripLeadingPaths": true,
          "skipTypeCheck": true
        },
        "dependsOn": [
          "^build"
        ]
      },
      "integration": {},
      "db-generate": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "drizzle-kit generate --config drizzle.config.ts"
        },
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "@basis/identity-application": "workspace:*",
    "@basis/identity-contracts": "workspace:*",
    "@basis/identity-infrastructure": "workspace:*",
    "@basis/metrics-application": "workspace:*",
    "@basis/metrics-contracts": "workspace:*",
    "@basis/metrics-infrastructure": "workspace:*",
    "@basis/shared-core": "workspace:*",
    "@basis/shared-domain": "workspace:*",
    "@basis/shared-infrastructure": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/cqrs": "12.1.0",
    "@nestjs/platform-express": "12.1.3",
    "drizzle-orm": "0.45.4",
    "express": "5.2.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@basis/shared-testing": "workspace:*",
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6"
  }
}
