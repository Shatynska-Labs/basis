{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "nx": {
    "name": "api",
    "tags": [
      "type:app",
      "scope:api"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "main": "apps/api/src/main.ts",
          "outputPath": "apps/api/dist",
          "tsConfig": "apps/api/tsconfig.app.json",
          "swcrc": "apps/api/.swcrc",
          "stripLeadingPaths": true,
          "skipTypeCheck": true
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
