{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out-tsc/app",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../libs/shared/infrastructure/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/testing/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/domain/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/core/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
